   "pageid": 97959980,
   "title": "File:20121007150DR Dresden Neumarkt Johanneum Frauenkirche.jpg",
   "imageinfo": [
    {
     "timestamp": "2020-12-22T19:16:25Z",
     "width": 3097,
     "height": 2355,
     "url": "https://upload.wikimedia.org/wikipedia/commons/6/69/20121007150DR_Dresden_Neumarkt_Johanneum_Frauenkirche.jpg",
     "extmetadata": {
